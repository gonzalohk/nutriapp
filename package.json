{
  "name": "nutrilara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first tracker for the meals a family receives from a healthy-catering service",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "TZ=UTC vitest run && TZ=America/La_Paz vitest run && TZ=Asia/Tokyo vitest run",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "holidays:generate": "tsx scripts/generate-holidays.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "types": "tsx scripts/gen-types.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "integration:setup": "bash scripts/setup-integration.sh",
    "dev:stack": "tsx scripts/dev-stack.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "date-holidays": "^3.37.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
